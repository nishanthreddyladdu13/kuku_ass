# Select an available text model that supports structured JSON. Never commit .env.
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=
# For openai_compatible, e.g. https://your-provider.example/v1
LLM_BASE_URL=
# Optional image-capable Gemini model. Defaults to Nano Banana 2.1.
IMAGE_MODEL=gemini-nano-banana-2.1
